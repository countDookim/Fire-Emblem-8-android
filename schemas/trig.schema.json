{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/countDookim/Fire-Emblem-8-android/schemas/trig.schema.json",
  "title": "GBA FE sine table (data/trig.json, format gbafe.trig)",
  "description": "The game's gSinLookup: 320 signed fixed-point values ('fractionBits' fraction bits). SIN(a) = sin[a & 0xFF], COS(a) = sin[0x40 + (a & 0xFF)], with 256 steps per turn.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "game", "version", "fractionBits", "sin"],
  "properties": {
    "format": { "const": "gbafe.trig" },
    "game": { "type": "string" },
    "version": { "const": 1 },
    "fractionBits": { "type": "integer", "minimum": 0, "maximum": 15 },
    "sin": { "type": "array", "minItems": 320, "maxItems": 320, "items": { "type": "integer", "minimum": -32768, "maximum": 32767 } }
  }
}
